<Window x:Class="SigmaCompta.App.Views.FenetreMessage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="500" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource PoliceTexte}" FontSize="{StaticResource TailleTexte}" Foreground="{StaticResource Texte}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Margin="24" Background="{StaticResource Surface}" CornerRadius="16" BorderBrush="{StaticResource Bordure}"
            BorderThickness="1" Effect="{StaticResource OmbreFlottante}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="26,26,26,20" MouseLeftButtonDown="Deplacer">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Pastille" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top">
                    <TextBlock x:Name="Icone" Style="{StaticResource Icone}" FontSize="{StaticResource TailleKpi}" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,2,0,0">
                    <TextBlock x:Name="Titre" Style="{StaticResource TitreCarte}" FontSize="{StaticResource TailleTitreCarte}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="Message" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{StaticResource TexteSecondaire}"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="{StaticResource SurfaceAlt}" CornerRadius="0,0,16,16"
                    BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0" Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BoutonAnnuler" Content="Annuler" MinWidth="100" Margin="0,0,10,0" IsCancel="True" Click="Annuler"/>
                    <Button x:Name="BoutonValider" Style="{StaticResource BoutonPrimaire}" MinWidth="110" IsDefault="True" Click="Valider"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
