<UserControl x:Class="SigmaCompta.App.Views.AccueilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Tuile carrée : icône au centre, libellé dessous. Grisée quand l'écran n'est pas encore accessible. -->
        <Style x:Key="Tuile" TargetType="Button">
            <Setter Property="Width" Value="122"/>
            <Setter Property="Height" Value="116"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="500"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fond" Background="{StaticResource Surface}" BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1" CornerRadius="10" Effect="{StaticResource OmbreCarte}" Padding="8,14,8,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="icone" Text="{Binding Icone}" Style="{StaticResource Icone}" FontSize="28"
                                           Foreground="{StaticResource Primaire}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="libelle" Grid.Row="1" Text="{Binding Libelle}" TextWrapping="Wrap" TextAlignment="Center"
                                           FontSize="{StaticResource TailleTexte}" Foreground="{StaticResource Texte}"
                                           Height="30" VerticalAlignment="Bottom" LineHeight="15" LineStackingStrategy="BlockLineHeight"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fond" Property="BorderBrush" Value="{StaticResource PrimaireBordure}"/>
                                <Setter TargetName="fond" Property="Background" Value="{StaticResource PrimaireDoux}"/>
                                <!-- Légère élévation au survol (une transformation ne peut pas être ciblée par TargetName : on la remplace). -->
                                <Setter TargetName="fond" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fond" Property="RenderTransform" Value="{x:Static Transform.Identity}"/>
                                <Setter TargetName="fond" Property="BorderBrush" Value="{StaticResource Primaire}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="fond" Property="BorderBrush" Value="{StaticResource Primaire}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fond" Property="Background" Value="#D3DAE5"/>
                                <Setter TargetName="fond" Property="BorderBrush" Value="#D3DAE5"/>
                                <Setter TargetName="fond" Property="Effect" Value="{x:Null}"/>
                                <Setter TargetName="icone" Property="Foreground" Value="#8392A8"/>
                                <Setter TargetName="libelle" Property="Foreground" Value="White"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitreSection" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PoliceTitre}"/>
            <Setter Property="FontSize" Value="{StaticResource TailleKpi}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            <Setter Property="Margin" Value="2,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="0,0,0,8">

            <!-- Bandeau de bienvenue : état du dossier et action conseillée -->
            <Border CornerRadius="14" Padding="22,18" Margin="0,0,8,24" Background="{StaticResource DegradeMarque}"
                    Effect="{StaticResource OmbreCarte}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="16" Background="#26FFFFFF" VerticalAlignment="Center">
                        <TextBlock Text="Σ" FontFamily="Cambria Math, Segoe UI" FontSize="28" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TitreBienvenue}" FontFamily="{StaticResource PoliceTitre}" FontSize="{StaticResource TailleGrand}"
                                   FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TexteBienvenue}" Foreground="#E6FFFFFF" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource Bouton}" VerticalAlignment="Center" Padding="16,8"
                            Command="{Binding ActionConseilleeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding IconeActionConseillee}" Style="{StaticResource Icone}" Foreground="{StaticResource Primaire}"/>
                            <TextBlock Text="{Binding LibelleActionConseillee}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Sections de tuiles : elles se rangent en colonnes quand la fenêtre est large -->
            <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,28,18" MaxWidth="520">
                            <TextBlock Text="{Binding Titre}" Style="{StaticResource TitreSection}"/>
                            <ItemsControl ItemsSource="{Binding Tuiles}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Tuile}" Command="{Binding OuvrirCommand}" ToolTip="{Binding Aide}"
                                                AutomationProperties.Name="{Binding Libelle}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
