<UserControl x:Class="SigmaCompta.App.Views.HistoriqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CarteKpi}">
                <StackPanel>
                    <TextBlock Text="EXÉCUTIONS ENREGISTRÉES" Style="{StaticResource KpiLibelle}"/>
                    <TextBlock Text="{Binding NombreImports}" Style="{StaticResource Kpi}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CarteKpi}">
                <StackPanel>
                    <TextBlock Text="PIÈCES IMPORTÉES" Style="{StaticResource KpiLibelle}"/>
                    <TextBlock Text="{Binding TotalPiecesImportees, StringFormat={}{0:N0}}" Style="{StaticResource Kpi}" Margin="0,4,0,0" Foreground="{StaticResource Succes}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CarteKpi}">
                <StackPanel>
                    <TextBlock Text="MONTANT IMPORTÉ (DÉBIT)" Style="{StaticResource KpiLibelle}"/>
                    <TextBlock Text="{Binding TotalMontant, StringFormat={}{0:#,##0.##}}" Style="{StaticResource Kpi}" FontSize="{StaticResource TailleKpi}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource BoutonIcone}" Content="&#xE72C;" ToolTip="Actualiser" Command="{Binding ActualiserCommand}"/>
                <Button Margin="6,0,0,0" Style="{StaticResource BoutonFantome}" Command="{Binding OuvrirRapportsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icone}" Margin="0,0,8,0"/>
                        <TextBlock Text="Dossier des rapports"/>
                    </StackPanel>
                </Button>
                <Button Margin="6,0,0,0" Style="{StaticResource BoutonFantome}" Command="{Binding ViderCommand}" Content="Vider l'historique"/>
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Carte}" Padding="12">
                <Grid>
                    <ListBox ItemsSource="{Binding Executions}" SelectedItem="{Binding Selection}" ItemContainerStyle="{StaticResource ElementListe}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding Date, StringFormat={}{0:dd/MM/yyyy HH:mm}, Mode=OneWay}"/>
                                            <Run Text="·" Foreground="{StaticResource TexteDiscret}"/>
                                            <Run Text="{Binding Base, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Bilan}" Style="{StaticResource Discret}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Fichier}" Style="{StaticResource Discret}" FontSize="{StaticResource TaillePetite}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Top" CornerRadius="10" Padding="8,2,9,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SuccesDoux}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Partiel">
                                                        <Setter Property="Background" Value="{StaticResource AvertDoux}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Échec">
                                                        <Setter Property="Background" Value="{StaticResource ErreurDoux}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Simulation">
                                                        <Setter Property="Background" Value="{StaticResource InfoDoux}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Statut}" Style="{StaticResource TextePastille}" Foreground="{StaticResource Texte}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Executions.Count, Converter={StaticResource ValeurVisibilite}, ConverterParameter=inverse}">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource Icone}" FontSize="28" Foreground="{StaticResource BordureForte}"/>
                        <TextBlock Text="Aucun import pour l'instant" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Carte}" Padding="0">
                <Grid>
                    <TextBlock Text="Sélectionne un import pour voir le détail des pièces." Style="{StaticResource Discret}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ASelection, Converter={StaticResource BoolVisibilite}, ConverterParameter=inverse}"/>
                    <DockPanel Visibility="{Binding ASelection, Converter={StaticResource BoolVisibilite}}">
                        <Grid DockPanel.Dock="Top" Margin="20,16,16,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TitreCarte}">
                                    <Run Text="Import du"/>
                                    <Run Text="{Binding Selection.Date, StringFormat={}{0:dd/MM/yyyy à HH:mm}, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Discret}" Margin="0,3,0,0">
                                    <Run Text="{Binding Selection.Serveur, Mode=OneWay}"/>
                                    <Run Text="›"/>
                                    <Run Text="{Binding Selection.Base, Mode=OneWay}"/>
                                    <Run Text="· paramètres :"/>
                                    <Run Text="{Binding Selection.Profil, Mode=OneWay}"/>
                                    <Run Text="· par"/>
                                    <Run Text="{Binding Selection.Utilisateur, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding ExporterCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icone}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Exporter"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Bordure}"/>
                        <DataGrid ItemsSource="{Binding Selection.Pieces}" AutoGenerateColumns="False" Margin="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STATUT" Binding="{Binding Statut}" Width="110" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="JOURNAL" Binding="{Binding Journal}" Width="80"/>
                                <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" Width="92"/>
                                <DataGridTextColumn Header="PIÈCE" Binding="{Binding Piece}" Width="110"/>
                                <DataGridTextColumn Header="EC_NO" Binding="{Binding EcNo}" Width="120"/>
                                <DataGridTextColumn Header="MONTANT" Binding="{Binding Montant, StringFormat={}{0:#,##0.##}}" Width="120" ElementStyle="{StaticResource CelluleDroite}"/>
                                <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*" ElementStyle="{StaticResource CelluleTexte}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
