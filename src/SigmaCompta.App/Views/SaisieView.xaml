<UserControl x:Class="SigmaCompta.App.Views.SaisieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SigmaCompta.App.Controls">
    <UserControl.Resources>
        <Style x:Key="EtiquetteChamp" TargetType="TextBlock" BasedOn="{StaticResource Etiquette}">
            <Setter Property="Margin" Value="1,0,0,3"/>
        </Style>
        <!-- Total du brouillard -->
        <Style x:Key="LigneBrouillard" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Genre}" Value="TotalGeneral">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaireFonce}"/>
                    <Setter Property="Background" Value="{StaticResource PrimaireDoux}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="280"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="120"/>
        </Grid.RowDefinitions>

        <!-- ============ Journal et période -->
        <Border Style="{StaticResource Carte}" Padding="12,8" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BoutonIcone}" Content="&#xE72C;" ToolTip="Relire les écritures enregistrées"
                        Command="{Binding ActualiserCommand}"/>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Journal" Style="{StaticResource EtiquetteChamp}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="230" ItemsSource="{Binding Journaux}" SelectedItem="{Binding JournalChoisi}" DisplayMemberPath="Affichage"/>
                    <TextBlock Text="Période" Style="{StaticResource EtiquetteChamp}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <ComboBox Width="150" ItemsSource="{Binding Periodes}" SelectedItem="{Binding PeriodeChoisie}" DisplayMemberPath="Libelle"
                              MaxDropDownHeight="420"/>
                    <TextBlock Text="{Binding InfoJournal}" Style="{StaticResource Discret}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ============ Bandeaux : procédure, période clôturée, chaînage -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource Encart}" Background="{StaticResource ErreurDoux}" BorderBrush="#F2C4C4" Margin="0,0,0,10"
                    Visibility="{Binding ProcedureAbsente, Converter={StaticResource BoolVisibilite}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Ouvrir la vérification" Command="{Binding VerificationCommand}" Margin="12,0,0,0"/>
                    <TextBlock Text="&#xE783;" Style="{StaticResource Icone}" Foreground="{StaticResource Erreur}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding MessageProcedure}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Encart}" Background="{StaticResource AvertDoux}" BorderBrush="#F3D9A6" Margin="0,0,0,10"
                    Visibility="{Binding MessageCloture, Converter={StaticResource ValeurVisibilite}}">
                <DockPanel>
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icone}" Foreground="{StaticResource Avert}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding MessageCloture}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Encart}" Background="{StaticResource AvertDoux}" BorderBrush="#F3D9A6" Margin="0,0,0,10"
                    Visibility="{Binding ChainageActif, Converter={StaticResource BoolVisibilite}}">
                <DockPanel>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icone}" Foreground="{StaticResource Avert}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Cette base chaîne ses écritures (chaînage d'inaltérabilité). L'enregistrement direct ne calcule pas ce chaînage : les pièces seraient hors chaîne."/>
                        <CheckBox Style="{StaticResource Interrupteur}" IsChecked="{Binding IgnorerHash}" Margin="0,8,0,0">
                            <TextBlock Text="Enregistrer hors chaînage, en connaissance de cause"/>
                        </CheckBox>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ============ Pièce en cours + suggestions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Carte}" Padding="12,10" Margin="0,0,10,0">
                <!-- Clavier : Entrée passe au champ suivant ; Entrée sur le crédit (ou sur un débit renseigné) ajoute la ligne -->
                <DockPanel PreviewKeyDown="LigneSaisie_PreviewKeyDown">
                    <!-- En-tête de la pièce -->
                    <WrapPanel DockPanel.Dock="Top">
                        <StackPanel Margin="0,0,8,4">
                            <TextBlock Text="Jour" Style="{StaticResource EtiquetteChamp}"/>
                            <c:ChampDate Width="118" Texte="{Binding JourTexte}" Indication="jj"
                                         DateMin="{Binding DebutPeriode}" DateMax="{Binding FinPeriode}" MoisParDefaut="{Binding DebutPeriode}"
                                         ToolTip="Jour du mois (17), date complète (17/10/2026) ou calendrier (F4)"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,4">
                            <TextBlock Text="N° pièce" Style="{StaticResource EtiquetteChamp}"/>
                            <TextBox Width="110" Text="{Binding PieceTexte, UpdateSourceTrigger=PropertyChanged}" Tag="automatique" MaxLength="13"
                                     ToolTip="Vide : numéro attribué automatiquement selon le journal"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,4">
                            <TextBlock Text="Référence" Style="{StaticResource EtiquetteChamp}"/>
                            <TextBox Width="130" Text="{Binding RefPieceTexte, UpdateSourceTrigger=PropertyChanged}" Tag="n° de facture…" MaxLength="17"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,4">
                            <TextBlock Text="Libellé de la pièce" Style="{StaticResource EtiquetteChamp}"/>
                            <TextBox Width="280" Text="{Binding LibellePiece, UpdateSourceTrigger=PropertyChanged}" Tag="repris sur chaque ligne" MaxLength="69"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ApercuDate}" Style="{StaticResource Discret}" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                    </WrapPanel>

                    <!-- Ligne de saisie -->
                    <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*" MinWidth="120"/>
                            <ColumnDefinition Width="116"/>
                            <ColumnDefinition Width="104"/>
                            <ColumnDefinition Width="104"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Compte" Style="{StaticResource EtiquetteChamp}"/>
                        <TextBlock Grid.Column="1" Text="Tiers" Style="{StaticResource EtiquetteChamp}" Margin="5,0,0,3"/>
                        <TextBlock Grid.Column="2" Text="Libellé" Style="{StaticResource EtiquetteChamp}" Margin="5,0,0,3"/>
                        <TextBlock Grid.Column="3" Text="Échéance" Style="{StaticResource EtiquetteChamp}" Margin="5,0,0,3"/>
                        <TextBlock Grid.Column="4" Text="Débit" Style="{StaticResource EtiquetteChamp}" Margin="5,0,0,3"/>
                        <TextBlock Grid.Column="5" Text="Crédit" Style="{StaticResource EtiquetteChamp}" Margin="5,0,0,3"/>

                        <TextBox x:Name="ChampCompte" Grid.Row="1" Text="{Binding CompteTexte, UpdateSourceTrigger=PropertyChanged}" Tag="n° ou nom"
                                 FontFamily="{StaticResource PoliceMono}" ToolTip="N° (401 → 4010000), début de n° ou partie de l'intitulé. Flèche bas : liste des comptes"/>
                        <TextBox x:Name="ChampTiers" Grid.Row="1" Grid.Column="1" Margin="5,0,0,0" Text="{Binding TiersTexte, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="facultatif" FontFamily="{StaticResource PoliceMono}"
                                 ToolTip="Tiers : son compte collectif est pris si le compte est vide. Flèche bas : liste des tiers"/>
                        <TextBox x:Name="ChampLibelle" Grid.Row="1" Grid.Column="2" Margin="5,0,0,0" Text="{Binding LibelleLigne, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="69"/>
                        <c:ChampDate x:Name="ChampEcheance" Grid.Row="1" Grid.Column="3" Margin="5,0,0,0" Texte="{Binding EcheanceTexte}"
                                     MoisParDefaut="{Binding DatePiece}"/>
                        <TextBox x:Name="ChampDebit" Grid.Row="1" Grid.Column="4" Margin="5,0,0,0" Text="{Binding DebitTexte, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Right"/>
                        <TextBox x:Name="ChampCredit" Grid.Row="1" Grid.Column="5" Margin="5,0,0,0" Text="{Binding CreditTexte, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Right"/>
                        <StackPanel Grid.Row="1" Grid.Column="6" Orientation="Horizontal" Margin="6,0,0,0">
                            <Button Content="{Binding LibelleBoutonLigne}" Command="{Binding ValiderLigneCommand}" MinWidth="90"/>
                            <Button Style="{StaticResource BoutonIcone}" Content="&#xE711;" ToolTip="Vider la ligne / annuler la modification"
                                    Command="{Binding AnnulerLigneCommand}" Margin="2,0,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="7" Margin="1,4,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding ApercuLigne, Mode=OneWay}" Foreground="{StaticResource TexteSecondaire}"/>
                            <Run Text="{Binding MessageLigne, Mode=OneWay}" Foreground="{StaticResource Erreur}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Grid>

                    <!-- Contrôles et résultat du serveur -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding AAnomalies, Converter={StaticResource BoolVisibilite}}">
                            <ItemsControl ItemsSource="{Binding Anomalies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource Erreur}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding MessageServeur}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Visibility="{Binding MessageServeur, Converter={StaticResource ValeurVisibilite}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Succes}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MessageServeurErreur}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Erreur}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Totaux et actions -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource BoutonIcone}" Content="&#xE70F;" ToolTip="Modifier la ligne sélectionnée (ou double-clic)"
                                    Command="{Binding ModifierLigneCommand}"/>
                            <Button Style="{StaticResource BoutonIcone}" Content="&#xE74D;" ToolTip="Supprimer la ligne sélectionnée (Suppr)"
                                    Command="{Binding SupprimerLigneCommand}" Margin="0,0,10,0"/>
                            <Button Content="Nouvelle pièce" Command="{Binding NouvellePieceCommand}" Margin="0,0,8,0"/>
                            <Button Content="Contrôler" Command="{Binding ControlerCommand}" Margin="0,0,8,0"
                                    ToolTip="Le serveur applique tous ses contrôles puis annule : rien n'est enregistré"/>
                            <Button Style="{StaticResource BoutonPrimaire}" Command="{Binding EnregistrerCommand}" Padding="16,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icone}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Enregistrer la pièce"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Débit " Style="{StaticResource Discret}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalDebit, StringFormat={}{0:#,##0.##}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="   Crédit " Style="{StaticResource Discret}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalCredit, StringFormat={}{0:#,##0.##}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Pastille}" Margin="12,0,0,0">
                                <TextBlock Text="{Binding EcartLibelle}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextePastille}">
                                            <Setter Property="Foreground" Value="{StaticResource Avert}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EstEquilibree}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Succes}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AucuneLigne}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TexteDiscret}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- Lignes de la pièce -->
                    <Border BorderBrush="{StaticResource Bordure}" BorderThickness="1" CornerRadius="8" Margin="0,8,0,0">
                        <Grid>
                            <DataGrid x:Name="LignesPiece" ItemsSource="{Binding Lignes}" SelectedItem="{Binding LigneSelectionnee}" AutoGenerateColumns="False"
                                      MouseDoubleClick="LignesPiece_MouseDoubleClick">
                                <DataGrid.InputBindings>
                                    <KeyBinding Key="Delete" Command="{Binding SupprimerLigneCommand}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="N°" Binding="{Binding Numero}" Width="36"/>
                                    <DataGridTextColumn Header="COMPTE" Binding="{Binding CompteGeneral}" Width="86"/>
                                    <DataGridTextColumn Header="INTITULÉ" Binding="{Binding IntituleCompte}" Width="*" MinWidth="110" ElementStyle="{StaticResource CelluleTexte}"/>
                                    <DataGridTextColumn Header="TIERS" Binding="{Binding CompteTiers}" Width="80"/>
                                    <DataGridTextColumn Header="LIBELLÉ" Binding="{Binding Libelle}" Width="1.4*" MinWidth="130" ElementStyle="{StaticResource CelluleTexte}"/>
                                    <DataGridTextColumn Header="ÉCHÉANCE" Binding="{Binding Echeance, StringFormat={}{0:dd/MM/yyyy}}" Width="80"/>
                                    <DataGridTextColumn Header="DÉBIT" Binding="{Binding DebitAffiche, StringFormat={}{0:#,##0.##}}" Width="100" ElementStyle="{StaticResource CelluleDroite}"/>
                                    <DataGridTextColumn Header="CRÉDIT" Binding="{Binding CreditAffiche, StringFormat={}{0:#,##0.##}}" Width="100" ElementStyle="{StaticResource CelluleDroite}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource Discret}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="20"
                                       Visibility="{Binding AucuneLigne, Converter={StaticResource BoolVisibilite}}"
                                       Text="Tapez le compte, le montant puis Entrée : la ligne s'ajoute ici et le montant qui équilibre la pièce est proposé pour la suivante."/>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Suggestions de comptes ou de tiers -->
            <Border Grid.Column="1" Style="{StaticResource Carte}" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding TitreSuggestions}" Style="{StaticResource EtiquetteChamp}"/>
                    <TextBlock DockPanel.Dock="Top" Text="Double-clic ou Entrée pour choisir" Style="{StaticResource Discret}" Margin="1,0,0,6"/>
                    <ListBox x:Name="ListeSuggestions" ItemsSource="{Binding Suggestions}" ItemContainerStyle="{StaticResource ElementListe}"
                             VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="Suggestions_MouseDoubleClick" PreviewKeyDown="Suggestions_PreviewKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Numero}" FontWeight="SemiBold" FontFamily="{StaticResource PoliceMono}"/>
                                    <TextBlock Text="{Binding Intitule}" Style="{StaticResource Discret}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               ToolTip="{Binding Intitule}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>

        <!-- ============ Écritures déjà enregistrées dans le journal et le mois -->
        <Border Grid.Row="4" Style="{StaticResource Carte}" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8,12,6">
                    <TextBlock Text="{Binding TitreBrouillard}" Style="{StaticResource TitreCarte}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ResumeBrouillard}" Style="{StaticResource Discret}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding LignesBrouillard}" AutoGenerateColumns="False" Margin="2" RowStyle="{StaticResource LigneBrouillard}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" Width="80"/>
                        <DataGridTextColumn Header="PIÈCE" Binding="{Binding Piece}" Width="78"/>
                        <DataGridTextColumn Header="RÉFÉRENCE" Binding="{Binding RefPiece}" Width="92"/>
                        <DataGridTextColumn Header="COMPTE" Binding="{Binding Compte}" Width="86"/>
                        <DataGridTextColumn Header="TIERS" Binding="{Binding CompteTiers}" Width="80"/>
                        <DataGridTextColumn Header="LIBELLÉ" Binding="{Binding Libelle}" Width="*" MinWidth="150" ElementStyle="{StaticResource CelluleTexte}"/>
                        <DataGridTextColumn Header="DÉBIT" Binding="{Binding Debit, StringFormat={}{0:#,##0.##}}" Width="104" ElementStyle="{StaticResource CelluleDroite}"/>
                        <DataGridTextColumn Header="CRÉDIT" Binding="{Binding Credit, StringFormat={}{0:#,##0.##}}" Width="104" ElementStyle="{StaticResource CelluleDroite}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
