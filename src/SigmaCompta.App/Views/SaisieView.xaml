<UserControl x:Class="SigmaCompta.App.Views.SaisieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SigmaCompta.App.Controls">
    <!-- Disposition inspirée de la fenêtre « Journal » des logiciels comptables : solde du compte de trésorerie en haut,
         ligne de saisie alignée sur les colonnes, grille du journal (enregistré + pièce en cours), totaux en bas. -->
    <UserControl.Resources>
        <!-- Largeurs communes à la ligne de saisie et à la grille, pour que les champs tombent sous leurs colonnes. -->
        <GridLength x:Key="LJour">52</GridLength>
        <GridLength x:Key="LPiece">92</GridLength>
        <GridLength x:Key="LFacture">104</GridLength>
        <GridLength x:Key="LReference">132</GridLength>
        <GridLength x:Key="LCompte">116</GridLength>
        <GridLength x:Key="LTiers">108</GridLength>
        <GridLength x:Key="LEcheance">112</GridLength>
        <GridLength x:Key="LMontant">112</GridLength>

        <!-- Champ de la ligne de saisie : indication grisée tant qu'il est vide, coins plus serrés -->
        <Style x:Key="ChampLigne" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="ChampMontant" TargetType="TextBox" BasedOn="{StaticResource ChampLigne}">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontFamily" Value="{StaticResource PoliceMono}"/>
        </Style>

        <!-- Panneaux bleutés (solde de trésorerie, totaux) -->
        <Style x:Key="PanneauTotaux" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InfoDoux}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaireBordure}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>
        <Style x:Key="LibelleTotal" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,2,24,2"/>
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
        </Style>
        <Style x:Key="MontantTotal" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="FontFamily" Value="{StaticResource PoliceMono}"/>
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
        </Style>
        <Style x:Key="EnteteTotal" TargetType="TextBlock" BasedOn="{StaticResource MontantTotal}">
            <Setter Property="FontFamily" Value="{StaticResource PoliceTexte}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Lignes de la pièce en cours : teintées et en demi-gras, à la suite des écritures enregistrées -->
        <Style x:Key="LigneJournal" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EnCours}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDoux}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="ToolTip" Value="Pièce en cours, non enregistrée. Double-clic pour modifier la ligne, Suppr pour la retirer."/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaireDoux}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="260"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Barre d'outils (journal, période, actions) et solde du compte de trésorerie -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Carte}" Padding="12,8" VerticalAlignment="Top">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="Journal" Style="{StaticResource Etiquette}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="230" ItemsSource="{Binding Journaux}" SelectedItem="{Binding JournalChoisi}" DisplayMemberPath="Affichage" Margin="0,0,0,4"/>
                        <TextBlock Text="Période" Style="{StaticResource Etiquette}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <ComboBox Width="150" ItemsSource="{Binding Periodes}" SelectedItem="{Binding PeriodeChoisie}" DisplayMemberPath="Libelle"
                                  MaxDropDownHeight="420" Margin="0,0,0,4"/>
                    </WrapPanel>
                    <Border Height="1" Background="{StaticResource Bordure}" Margin="0,6,0,6"/>
                    <WrapPanel>
                        <Button Style="{StaticResource BoutonFantome}" Command="{Binding EquilibrerCommand}" Margin="0,0,6,0"
                                ToolTip="Met sur la ligne en saisie le montant qui équilibre la pièce">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8EF;" Style="{StaticResource Icone}" Margin="0,0,7,0"/>
                                <TextBlock Text="Équilibrer"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BoutonFantome}" Command="{Binding ControlerCommand}" Margin="0,0,6,0"
                                ToolTip="Le serveur applique tous ses contrôles puis annule : rien n'est enregistré">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D5;" Style="{StaticResource Icone}" Margin="0,0,7,0"/>
                                <TextBlock Text="Contrôler la pièce"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BoutonFantome}" Command="{Binding ActualiserCommand}"
                                ToolTip="Relire les écritures enregistrées du journal">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icone}" Margin="0,0,7,0"/>
                                <TextBlock Text="Actualiser"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Compte de trésorerie du journal : ancien solde, mouvements enregistrés, nouveau solde -->
            <Border Grid.Column="1" Style="{StaticResource PanneauTotaux}" Margin="10,0,0,0" MinWidth="440" VerticalAlignment="Top"
                    Visibility="{Binding ASituation, Converter={StaticResource BoolVisibilite}}"
                    ToolTip="Ancien solde : écritures du compte dans ce journal, du début de l'exercice à la veille de la période. Mouvements : écritures enregistrées du compte dans ce journal pour la période.">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="110"/>
                        <ColumnDefinition Width="*" MinWidth="110"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource EnteteTotal}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="0,0,16,4">
                        <Run Text="{Binding Situation.Compte, Mode=OneWay}"/>
                        <Run Text="{Binding Situation.Intitule, Mode=OneWay}" FontWeight="Normal" Foreground="{StaticResource TexteSecondaire}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="Débit" Style="{StaticResource EnteteTotal}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Column="2" Text="Crédit" Style="{StaticResource EnteteTotal}" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="1" Text="Ancien solde" Style="{StaticResource LibelleTotal}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Situation.AncienDebit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource MontantTotal}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Situation.AncienCredit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource MontantTotal}"/>

                    <TextBlock Grid.Row="2" Text="Mouvements" Style="{StaticResource LibelleTotal}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Situation.MouvementsDebit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource MontantTotal}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Situation.MouvementsCredit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource MontantTotal}"/>

                    <TextBlock Grid.Row="3" Text="Nouveau solde" Style="{StaticResource LibelleTotal}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Situation.NouveauDebit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource MontantTotal}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Situation.NouveauCredit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource MontantTotal}" FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Bandeaux : procédure, période clôturée, chaînage -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource Encart}" Background="{StaticResource ErreurDoux}" BorderBrush="#F2C4C4" Margin="0,0,0,10"
                    Visibility="{Binding ProcedureAbsente, Converter={StaticResource BoolVisibilite}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Ouvrir la vérification" Command="{Binding VerificationCommand}" Margin="12,0,0,0"/>
                    <TextBlock Text="&#xE783;" Style="{StaticResource Icone}" Foreground="{StaticResource Erreur}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding MessageProcedure}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Encart}" Background="{StaticResource AvertDoux}" BorderBrush="#F3D9A6" Margin="0,0,0,10"
                    Visibility="{Binding MessageCloture, Converter={StaticResource ValeurVisibilite}}">
                <DockPanel>
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icone}" Foreground="{StaticResource Avert}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding MessageCloture}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Encart}" Background="{StaticResource AvertDoux}" BorderBrush="#F3D9A6" Margin="0,0,0,10"
                    Visibility="{Binding ChainageActif, Converter={StaticResource BoolVisibilite}}">
                <DockPanel>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icone}" Foreground="{StaticResource Avert}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Cette base chaîne ses écritures (chaînage d'inaltérabilité). L'enregistrement direct ne calcule pas ce chaînage : les pièces seraient hors chaîne."/>
                        <CheckBox Style="{StaticResource Interrupteur}" IsChecked="{Binding IgnorerHash}" Margin="0,8,0,0">
                            <TextBlock Text="Enregistrer hors chaînage, en connaissance de cause"/>
                        </CheckBox>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ============ Ligne de saisie + grille du journal -->
        <Border Grid.Row="2" Style="{StaticResource Carte}" Padding="0">
            <DockPanel>
                <!-- Ligne de saisie. Clavier : Entrée passe au champ suivant ; Entrée sur le crédit (ou sur un débit renseigné)
                     ajoute la ligne ; flèche bas sur le compte ou le tiers ouvre la liste. -->
                <Grid x:Name="ZoneSaisie" DockPanel.Dock="Top" Margin="8,10,19,0" PreviewKeyDown="LigneSaisie_PreviewKeyDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource LJour}"/>
                        <ColumnDefinition Width="{StaticResource LPiece}"/>
                        <ColumnDefinition Width="{StaticResource LFacture}"/>
                        <ColumnDefinition Width="{StaticResource LReference}"/>
                        <ColumnDefinition Width="{StaticResource LCompte}"/>
                        <ColumnDefinition Width="{StaticResource LTiers}"/>
                        <ColumnDefinition Width="*" MinWidth="140"/>
                        <ColumnDefinition Width="{StaticResource LEcheance}"/>
                        <ColumnDefinition Width="{StaticResource LMontant}"/>
                        <ColumnDefinition Width="{StaticResource LMontant}"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ChampJour" Style="{StaticResource ChampLigne}" Text="{Binding JourTexte, UpdateSourceTrigger=PropertyChanged}" Tag="Jour"
                             MaxLength="10" TextAlignment="Right" ToolTip="{Binding ApercuDate}"/>
                    <TextBox Grid.Column="1" Style="{StaticResource ChampLigne}" Text="{Binding PieceTexte, UpdateSourceTrigger=PropertyChanged}" Tag="N° pièce"
                             MaxLength="13" ToolTip="Vide : numéro attribué automatiquement selon le journal"/>
                    <TextBox Grid.Column="2" Style="{StaticResource ChampLigne}" Text="{Binding RefPieceTexte, UpdateSourceTrigger=PropertyChanged}" Tag="N° facture"
                             MaxLength="17" ToolTip="N° de facture, repris sur chaque ligne de la pièce"/>
                    <TextBox x:Name="ChampReference" Grid.Column="3" Style="{StaticResource ChampLigne}" Text="{Binding ReferenceTexte, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Référence" MaxLength="17" ToolTip="Référence de la ligne (reprise sur la ligne suivante)"/>
                    <TextBox x:Name="ChampCompte" Grid.Column="4" Style="{StaticResource ChampLigne}" Text="{Binding CompteTexte, UpdateSourceTrigger=PropertyChanged}"
                             Tag="N° compte gén." FontFamily="{StaticResource PoliceMono}" TextChanged="ChampCompte_TextChanged"
                             LostKeyboardFocus="ChampListe_LostKeyboardFocus"
                             ToolTip="N° (401 → 4010000), début de n° ou partie de l'intitulé. Flèche bas : liste des comptes"/>
                    <TextBox x:Name="ChampTiers" Grid.Column="5" Style="{StaticResource ChampLigne}" Text="{Binding TiersTexte, UpdateSourceTrigger=PropertyChanged}"
                             Tag="N° compte tiers" FontFamily="{StaticResource PoliceMono}" TextChanged="ChampCompte_TextChanged"
                             LostKeyboardFocus="ChampListe_LostKeyboardFocus"
                             ToolTip="Tiers : son compte collectif est pris si le compte général est vide. Flèche bas : liste des tiers"/>
                    <TextBox x:Name="ChampLibelle" Grid.Column="6" Style="{StaticResource ChampLigne}" Text="{Binding LibelleLigne, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Libellé écriture" MaxLength="69"/>
                    <c:ChampDate x:Name="ChampEcheance" Grid.Column="7" Margin="0,0,4,0" Texte="{Binding EcheanceTexte}" Indication="Date échéance"
                                 MoisParDefaut="{Binding DatePiece}"/>
                    <TextBox x:Name="ChampDebit" Grid.Column="8" Style="{StaticResource ChampMontant}" Text="{Binding DebitTexte, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Débit"/>
                    <TextBox x:Name="ChampCredit" Grid.Column="9" Style="{StaticResource ChampMontant}" Margin="0" Text="{Binding CreditTexte, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Crédit"/>
                </Grid>

                <!-- Bande d'actions : comptes reconnus à gauche, boutons à droite -->
                <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Bordure}" BorderThickness="0,1"
                        Margin="0,10,0,0" Padding="8,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Nouveau" Command="{Binding NouvellePieceCommand}" Margin="0,0,6,0"
                                    ToolTip="Abandonner la pièce en cours et en commencer une autre"/>
                            <Button Content="Supprimer" Command="{Binding SupprimerLigneCommand}" Margin="0,0,6,0"
                                    ToolTip="Retirer la ligne sélectionnée de la pièce en cours (Suppr)"/>
                            <Button Content="{Binding LibelleBoutonLigne}" Command="{Binding ValiderLigneCommand}" Margin="0,0,6,0" MinWidth="96"
                                    ToolTip="Ajouter la ligne tapée à la pièce (Entrée sur le montant)"/>
                            <Button Style="{StaticResource BoutonIcone}" Content="&#xE711;" ToolTip="Vider la ligne / annuler la modification"
                                    Command="{Binding AnnulerLigneCommand}" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource BoutonPrimaire}" Command="{Binding EnregistrerCommand}" Padding="14,5"
                                    ToolTip="Enregistrer la pièce dans la base comptable">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icone}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Enregistrer"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,12,0">
                            <Run Text="{Binding ApercuDate, Mode=OneWay}" Foreground="{StaticResource TexteDiscret}"/>
                            <Run Text="   "/>
                            <Run Text="{Binding MessageLigne, Mode=OneWay}" Foreground="{StaticResource Erreur}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- Grille du journal : écritures enregistrées du mois, puis lignes de la pièce en cours -->
                <Grid>
                    <DataGrid x:Name="GrilleJournal" ItemsSource="{Binding LignesGrille}" SelectedItem="{Binding LigneGrilleSelectionnee}"
                              AutoGenerateColumns="False" RowStyle="{StaticResource LigneJournal}" Margin="0,0,0,4"
                              MouseDoubleClick="GrilleJournal_MouseDoubleClick">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding SupprimerLigneCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Jour" Binding="{Binding Jour}" Width="52" ElementStyle="{StaticResource CelluleDroite}"/>
                            <DataGridTextColumn Header="N° pièce" Binding="{Binding Piece}" Width="92"/>
                            <DataGridTextColumn Header="N° facture" Binding="{Binding Facture}" Width="104" ElementStyle="{StaticResource CelluleTexte}"/>
                            <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="132" ElementStyle="{StaticResource CelluleTexte}"/>
                            <DataGridTextColumn Header="N° compte général" Binding="{Binding Compte}" Width="116"/>
                            <DataGridTextColumn Header="N° compte tiers" Binding="{Binding Tiers}" Width="108"/>
                            <DataGridTextColumn Header="Libellé écriture" Binding="{Binding Libelle}" Width="*" MinWidth="140" ElementStyle="{StaticResource CelluleTexte}"/>
                            <DataGridTextColumn Header="Date échéance" Binding="{Binding Echeance, StringFormat={}{0:dd/MM/yyyy}}" Width="112"/>
                            <DataGridTextColumn Header="Débit" Binding="{Binding Debit, StringFormat={}{0:#,##0.##}}" Width="112" ElementStyle="{StaticResource CelluleDroite}"/>
                            <DataGridTextColumn Header="Crédit" Binding="{Binding Credit, StringFormat={}{0:#,##0.##}}" Width="112" ElementStyle="{StaticResource CelluleDroite}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Style="{StaticResource Discret}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="20,40,20,20"
                               MaxWidth="520" Visibility="{Binding NombreElements, Converter={StaticResource ValeurVisibilite}, ConverterParameter=inverse}"
                               Text="Aucune écriture dans ce journal pour ce mois. Tapez le jour, le compte, le montant puis Entrée : la ligne s'ajoute ici et le montant qui équilibre la pièce est proposé pour la suivante."/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============ Compte reconnu, contrôles | totaux du journal et solde à équilibrer -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Carte}" Padding="14,10" Margin="0,0,10,0" MinHeight="96">
                <StackPanel>
                    <TextBlock TextTrimming="CharacterEllipsis">
                        <Run Text="Compte :" FontWeight="SemiBold"/>
                        <Run Text="{Binding ApercuLigne, Mode=OneWay}" Foreground="{StaticResource TexteSecondaire}"/>
                    </TextBlock>
                    <ScrollViewer MaxHeight="58" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                                  Visibility="{Binding AAnomalies, Converter={StaticResource BoolVisibilite}}">
                        <ItemsControl ItemsSource="{Binding Anomalies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource Erreur}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding MessageServeur}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,0"
                               Visibility="{Binding MessageServeur, Converter={StaticResource ValeurVisibilite}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Succes}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageServeurErreur}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Erreur}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanneauTotaux}" MinWidth="440">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="1" Text="Débit" Style="{StaticResource EnteteTotal}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Column="2" Text="Crédit" Style="{StaticResource EnteteTotal}" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="1" Text="Totaux journal" Style="{StaticResource LibelleTotal}"
                               ToolTip="Écritures enregistrées du mois, plus la pièce en cours"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalJournalDebit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource MontantTotal}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TotalJournalCredit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource MontantTotal}"/>

                    <TextBlock Grid.Row="2" Text="Solde à équilibrer" Style="{StaticResource LibelleTotal}"
                               ToolTip="Montant à saisir, dans cette colonne, pour équilibrer la pièce en cours (bouton Équilibrer)"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SoldeAEquilibrerDebit, StringFormat={}{0:#,##0.##}}"
                               Style="{StaticResource MontantTotal}" Foreground="{StaticResource Avert}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SoldeAEquilibrerCredit, StringFormat={}{0:#,##0.##}}"
                               Style="{StaticResource MontantTotal}" Foreground="{StaticResource Avert}" FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Barre d'état -->
        <Border Grid.Row="4" BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="2,6,2,0">
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Pastille}">
                    <TextBlock Text="{Binding EcartLibelle}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextePastille}">
                                <Setter Property="Foreground" Value="{StaticResource Avert}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EstEquilibree}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Succes}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AucuneLigne}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TexteDiscret}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Discret}" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Run Text="Pièce en cours :"/>
                    <Run Text="{Binding Lignes.Count, Mode=OneWay}"/>
                    <Run Text="ligne(s)"/>
                </TextBlock>
                <TextBlock Style="{StaticResource Discret}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding NombreElements, Mode=OneWay, StringFormat={}{0:N0}}"/>
                    <Run Text="élément(s) de la liste"/>
                    <Run Text="  ·  "/>
                    <Run Text="{Binding ResumeBrouillard, Mode=OneWay}"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Liste des comptes ou des tiers, déroulée sous le champ en cours de frappe -->
        <Popup x:Name="PopupSuggestions" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade"
               VerticalOffset="2">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BordureForte}" BorderThickness="1" CornerRadius="8"
                    Margin="0,0,10,10" Effect="{StaticResource OmbreFlottante}" Padding="4">
                <DockPanel Width="380">
                    <TextBlock DockPanel.Dock="Top" Margin="6,4,6,4" Style="{StaticResource Discret}">
                        <Run Text="{Binding TitreSuggestions, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TexteSecondaire}"/>
                        <Run Text=" · flèches puis Entrée, ou clic"/>
                    </TextBlock>
                    <ListBox x:Name="ListeSuggestions" ItemsSource="{Binding Suggestions}" ItemContainerStyle="{StaticResource ElementListe}"
                             MaxHeight="280" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True"
                             PreviewKeyDown="Suggestions_PreviewKeyDown" PreviewMouseLeftButtonUp="Suggestions_PreviewMouseLeftButtonUp"
                             LostKeyboardFocus="ChampListe_LostKeyboardFocus">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Numero}" FontWeight="SemiBold" FontFamily="{StaticResource PoliceMono}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Intitule}" Foreground="{StaticResource TexteSecondaire}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Intitule}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
