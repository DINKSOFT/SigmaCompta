<UserControl x:Class="SigmaCompta.App.Views.ConsultationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SigmaCompta.App.Controls">
    <UserControl.Resources>
        <Style x:Key="CarteKpiCompacte" TargetType="Border" BasedOn="{StaticResource CarteKpi}">
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <!-- Ligne de report à nouveau : en gras, sur fond discret -->
        <Style x:Key="LigneConsultation" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstReport}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Liste des comptes (repliable) -->
        <Border Style="{StaticResource Carte}" Padding="12" Width="290" Margin="0,0,18,0"
                Visibility="{Binding ListeVisible, Converter={StaticResource BoolVisibilite}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Segments}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="nature" Content="Comptes généraux" IsChecked="{Binding NatureGenerale}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="nature" Content="Tiers" IsChecked="{Binding NatureTiers}"/>
                    </StackPanel>
                </Border>
                <TextBox DockPanel.Dock="Top" Margin="0,10,0,6" Tag="N° de compte ou intitulé…"
                         Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged, Delay=250}"/>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Discret}" Margin="4,0,0,6"
                           Text="{Binding NombreComptes, StringFormat={}{0:N0} compte(s)}"/>
                <Grid>
                    <ListBox ItemsSource="{Binding ComptesFiltres}" SelectedItem="{Binding CompteSelectionne}"
                             ItemContainerStyle="{StaticResource ElementListe}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Numero}" FontWeight="SemiBold" FontFamily="{StaticResource PoliceMono}"/>
                                    <TextBlock Text="{Binding Intitule}" Style="{StaticResource Discret}" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" ToolTip="{Binding Intitule}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Aucun compte ne correspond." Style="{StaticResource Discret}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding NombreComptes, Converter={StaticResource ValeurVisibilite}, ConverterParameter=inverse}"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============ Compte consulté -->
        <DockPanel Grid.Column="1">
            <!-- En-tête : compte, navigation, export -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BoutonIcone}" Content="&#xE8A0;" ToolTip="Afficher / masquer la liste des comptes"
                            Command="{Binding BasculerListeCommand}"/>
                    <Button Style="{StaticResource BoutonIcone}" Content="&#xE76B;" ToolTip="Compte précédent" Margin="4,0,0,0"
                            Command="{Binding ComptePrecedentCommand}"/>
                    <Button Style="{StaticResource BoutonIcone}" Content="&#xE76C;" ToolTip="Compte suivant"
                            Command="{Binding CompteSuivantCommand}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TitreCarte}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding CompteAffiche, Mode=OneWay}" FontFamily="{StaticResource PoliceMono}"/>
                        <Run Text="{Binding IntituleAffiche, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Resume}" Style="{StaticResource Discret}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ImprimerCommand}" Margin="0,0,8,0" ToolTip="Ouvre l'extrait de compte en PDF pour l'imprimer (Ctrl+P)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" Style="{StaticResource Icone}" Margin="0,0,8,0"/>
                            <TextBlock Text="Imprimer"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding PdfCommand}" Margin="0,0,8,0" ToolTip="Enregistrer l'extrait de compte en PDF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icone}" Margin="0,0,8,0"/>
                            <TextBlock Text="PDF"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExporterCommand}" ToolTip="Exporter en classeur Excel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icone}" Margin="0,0,8,0"/>
                            <TextBlock Text="Excel"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Période et filtre de lettrage (passent à la ligne sur un écran étroit) -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel Margin="0,0,12,6">
                    <TextBlock Text="Exercice" Style="{StaticResource Etiquette}"/>
                    <ComboBox Width="200" ItemsSource="{Binding Exercices}" SelectedItem="{Binding ExerciceSelectionne}"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,6">
                    <TextBlock Text="Du" Style="{StaticResource Etiquette}"/>
                    <c:ChampDate Width="124" Texte="{Binding DuTexte}"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,6">
                    <TextBlock Text="Au" Style="{StaticResource Etiquette}"/>
                    <c:ChampDate Width="124" Texte="{Binding AuTexte}"/>
                </StackPanel>
                <Button Style="{StaticResource BoutonIcone}" Content="&#xE72C;" ToolTip="Actualiser" VerticalAlignment="Bottom"
                        Margin="0,0,20,6" Command="{Binding ConsulterCommand}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <RadioButton Style="{StaticResource PuceFiltre}" GroupName="lettrage" Content="Toutes les lignes"
                                 IsChecked="{Binding FiltreLettrage, Converter={StaticResource EgalVersBool}, ConverterParameter=Toutes}"/>
                    <RadioButton Style="{StaticResource PuceFiltre}" GroupName="lettrage" Content="Non lettrées"
                                 IsChecked="{Binding FiltreLettrage, Converter={StaticResource EgalVersBool}, ConverterParameter=NonLettrees}"/>
                    <RadioButton Style="{StaticResource PuceFiltre}" GroupName="lettrage" Content="Lettrées"
                                 IsChecked="{Binding FiltreLettrage, Converter={StaticResource EgalVersBool}, ConverterParameter=Lettrees}"/>
                </StackPanel>
            </WrapPanel>

            <!-- Indicateurs -->
            <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource CarteKpiCompacte}">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportTitre}" Style="{StaticResource KpiLibelle}"/>
                        <TextBlock Text="{Binding ReportLibelle}" Style="{StaticResource Kpi}" FontSize="{StaticResource TailleKpi}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CarteKpiCompacte}">
                    <StackPanel>
                        <TextBlock Text="DÉBIT DE LA PÉRIODE" Style="{StaticResource KpiLibelle}"/>
                        <TextBlock Text="{Binding TotalDebit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource Kpi}" FontSize="{StaticResource TailleKpi}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CarteKpiCompacte}">
                    <StackPanel>
                        <TextBlock Text="CRÉDIT DE LA PÉRIODE" Style="{StaticResource KpiLibelle}"/>
                        <TextBlock Text="{Binding TotalCredit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource Kpi}" FontSize="{StaticResource TailleKpi}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CarteKpiCompacte}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{Binding SoldeTitre}" Style="{StaticResource KpiLibelle}"/>
                        <TextBlock Text="{Binding SoldeLibelle}" Style="{StaticResource Kpi}" FontSize="{StaticResource TailleKpi}" Margin="0,6,0,0"
                                   Foreground="{StaticResource Primaire}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Écritures du compte -->
            <Border Style="{StaticResource Carte}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Lignes}" AutoGenerateColumns="False" Margin="2"
                              RowStyle="{StaticResource LigneConsultation}"
                              Visibility="{Binding AResultat, Converter={StaticResource BoolVisibilite}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" Width="86"/>
                            <DataGridTextColumn Header="JNL" Binding="{Binding Journal}" Width="62"/>
                            <DataGridTextColumn Header="PIÈCE" Binding="{Binding Piece}" Width="80"/>
                            <DataGridTextColumn Header="LIBELLÉ" Binding="{Binding Libelle}" Width="*" MinWidth="150" ElementStyle="{StaticResource CelluleTexte}"/>
                            <DataGridTextColumn Header="CPTE ASSOCIÉ" Binding="{Binding CompteAssocie}" Width="96"/>
                            <DataGridTextColumn Header="DÉBIT" Binding="{Binding DebitAffiche, StringFormat={}{0:#,##0.##}}" Width="104" ElementStyle="{StaticResource CelluleDroite}"/>
                            <DataGridTextColumn Header="CRÉDIT" Binding="{Binding CreditAffiche, StringFormat={}{0:#,##0.##}}" Width="104" ElementStyle="{StaticResource CelluleDroite}"/>
                            <DataGridTextColumn Header="SOLDE" Binding="{Binding SoldeLibelle}" Width="122" ElementStyle="{StaticResource CelluleDroite}"/>
                            <DataGridTextColumn Header="LETTR." Binding="{Binding Lettrage}" Width="58"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ACompte, Converter={StaticResource BoolVisibilite}, ConverterParameter=inverse}">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icone}" FontSize="28" Foreground="{StaticResource BordureForte}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Choisis un compte dans la liste" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ses écritures s'affichent ici, avec le report à nouveau et le solde après chaque ligne."
                                   Style="{StaticResource Discret}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Aucune écriture sur cette période." Style="{StaticResource Discret}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding AucuneLigne, Converter={StaticResource BoolVisibilite}}"/>
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
