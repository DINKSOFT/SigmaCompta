<UserControl x:Class="SigmaCompta.App.Views.ConsultationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SigmaCompta.App.Controls">
    <!-- Disposition de l'« Interrogation et lettrage » des logiciels comptables : barre d'outils et recherche, choix du compte,
         volet gauche (vues et type d'écriture), bande de lettrage, grille des écritures, critères et totaux en bas. -->
    <UserControl.Resources>
        <!-- Volet gauche : Interrogation / Cumuls généraux -->
        <Style x:Key="ElementVolet" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="6" Padding="10,6" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceSurvol}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Primaire}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TypeEcriture" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            <Setter Property="Margin" Value="2,4,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="typeEcriture"/>
        </Style>

        <!-- Panneaux bleutés (solde de lettrage, totaux) -->
        <Style x:Key="PanneauTotaux" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InfoDoux}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaireBordure}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        <Style x:Key="LibelleTotal" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,2,24,2"/>
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
        </Style>
        <Style x:Key="MontantTotal" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="FontFamily" Value="{StaticResource PoliceMono}"/>
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
        </Style>
        <Style x:Key="EnteteTotal" TargetType="TextBlock" BasedOn="{StaticResource MontantTotal}">
            <Setter Property="FontFamily" Value="{StaticResource PoliceTexte}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Ligne de report en gras ; ligne cochée pour le lettrage teintée -->
        <Style x:Key="LigneInterrogation" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Ligne.EstReport}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Cochee}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDoux}"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaireDoux}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="260"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Barre d'outils : impression, exports | recherche dans la liste -->
        <Border Style="{StaticResource Carte}" Padding="8,6" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource BoutonFantome}" Command="{Binding ImprimerCommand}" Margin="0,0,4,0"
                            ToolTip="Ouvre l'extrait de compte en PDF pour l'imprimer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" Style="{StaticResource Icone}" Margin="0,0,7,0"/>
                            <TextBlock Text="Imprimer"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonFantome}" Command="{Binding PdfCommand}" Margin="0,0,4,0"
                            ToolTip="Enregistrer l'extrait de compte en PDF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icone}" Margin="0,0,7,0"/>
                            <TextBlock Text="PDF"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonFantome}" Command="{Binding ExporterCommand}" Margin="0,0,12,0"
                            ToolTip="Exporter les écritures en classeur Excel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icone}" Margin="0,0,7,0"/>
                            <TextBlock Text="Excel"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid>
                    <TextBox Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged, Delay=250}" Tag="Rechercher des mots dans la liste…"
                             Padding="30,5,8,5"
                             ToolTip="Chaque mot doit apparaître dans la ligne : libellé, pièce, facture, référence, compte, lettrage, date (310726 ou 31/07/2026) ou montant"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icone}" Foreground="{StaticResource TexteDiscret}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============ Compte et période -->
        <Border Grid.Row="1" Style="{StaticResource Carte}" Padding="12,8" Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BoutonPrimaire}" Command="{Binding AfficherCommand}" Padding="18,5"
                        VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="Lire les écritures du compte (Entrée dans le champ du compte)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icone}" Margin="0,0,8,0"/>
                        <TextBlock Text="Afficher"/>
                    </StackPanel>
                </Button>
                <WrapPanel VerticalAlignment="Center">
                    <ComboBox Width="150" ItemsSource="{Binding Natures}" SelectedIndex="{Binding NatureIndex}" Margin="0,2,6,2"
                              ToolTip="Interroger un compte général ou un compte tiers"/>
                    <ComboBox x:Name="ChampCompte" Width="340" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Numero"
                              ItemsSource="{Binding Comptes}" Text="{Binding CompteTexte, UpdateSourceTrigger=PropertyChanged}"
                              MaxDropDownHeight="420" ScrollViewer.CanContentScroll="True" Margin="0,2,4,2"
                              ToolTip="N° de compte, début de n° ou partie de l'intitulé, puis Entrée">
                        <ComboBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AfficherCommand}"/>
                        </ComboBox.InputBindings>
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel VirtualizationMode="Recycling"/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Numero}" FontWeight="SemiBold" FontFamily="{StaticResource PoliceMono}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Intitule}" Foreground="{StaticResource TexteSecondaire}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Style="{StaticResource BoutonIcone}" Content="&#xE76B;" ToolTip="Compte précédent" Command="{Binding ComptePrecedentCommand}"/>
                    <Button Style="{StaticResource BoutonIcone}" Content="&#xE76C;" ToolTip="Compte suivant" Command="{Binding CompteSuivantCommand}" Margin="0,0,16,0"/>

                    <TextBlock Text="Exercice" Style="{StaticResource Etiquette}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="190" ItemsSource="{Binding Exercices}" SelectedItem="{Binding ExerciceSelectionne}" Margin="0,2,12,2"/>
                    <TextBlock Text="Du" Style="{StaticResource Etiquette}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <c:ChampDate Width="124" Texte="{Binding DuTexte}" Margin="0,2,8,2"/>
                    <TextBlock Text="au" Style="{StaticResource Etiquette}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <c:ChampDate Width="124" Texte="{Binding AuTexte}" Margin="0,2,0,2"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ============ Volet gauche | lettrage + écritures (ou cumuls) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Carte}" Padding="8" Margin="0,0,8,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton Style="{StaticResource ElementVolet}" GroupName="vue" Content="Interrogation"
                                     IsChecked="{Binding Vue, Converter={StaticResource EgalVersBool}, ConverterParameter=Interrogation}"/>
                        <RadioButton Style="{StaticResource ElementVolet}" GroupName="vue" Content="Cumuls généraux" Margin="0,2,0,0"
                                     IsChecked="{Binding Vue, Converter={StaticResource EgalVersBool}, ConverterParameter=Cumuls}"
                                     ToolTip="Débit, crédit et solde cumulé du compte, mois par mois depuis le début de l'exercice"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{StaticResource Bordure}" Margin="0,0,0,8"/>
                        <TextBlock Text="Type d'écriture" FontWeight="SemiBold" Margin="2,0,0,4"/>
                        <RadioButton Style="{StaticResource TypeEcriture}" Content="Écritures non lettrées"
                                     IsChecked="{Binding TypeEcriture, Converter={StaticResource EgalVersBool}, ConverterParameter=NonLettrees}"/>
                        <RadioButton Style="{StaticResource TypeEcriture}" Content="Écritures lettrées"
                                     IsChecked="{Binding TypeEcriture, Converter={StaticResource EgalVersBool}, ConverterParameter=Lettrees}"/>
                        <RadioButton Style="{StaticResource TypeEcriture}" Content="Écritures non pointées"
                                     IsChecked="{Binding TypeEcriture, Converter={StaticResource EgalVersBool}, ConverterParameter=NonPointees}"/>
                        <RadioButton Style="{StaticResource TypeEcriture}" Content="Écritures pointées"
                                     IsChecked="{Binding TypeEcriture, Converter={StaticResource EgalVersBool}, ConverterParameter=Pointees}"/>
                        <RadioButton Style="{StaticResource TypeEcriture}" Content="Toutes les écritures"
                                     IsChecked="{Binding TypeEcriture, Converter={StaticResource EgalVersBool}, ConverterParameter=Toutes}"/>
                        <Button Style="{StaticResource BoutonFantome}" Command="{Binding EffacerCriteresCommand}" HorizontalAlignment="Left"
                                Margin="0,6,0,0" Padding="4,3" ToolTip="Toutes les écritures de l'exercice en cours, sans recherche">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE894;" Style="{StaticResource Icone}" Margin="0,0,6,0"/>
                                <TextBlock Text="Effacer les critères"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Carte}" Padding="0">
                <Grid>
                    <!-- ===== Interrogation : bande de lettrage + écritures -->
                    <DockPanel Visibility="{Binding VueInterrogation, Converter={StaticResource BoolVisibilite}}">
                        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Bordure}" BorderThickness="0,0,0,1"
                                Padding="12,8" CornerRadius="12,12,0,0">
                            <DockPanel>
                                <!-- Solde des lignes cochées -->
                                <Border DockPanel.Dock="Right" Style="{StaticResource PanneauTotaux}" MinWidth="420" Margin="12,0,0,0"
                                        ToolTip="Total des lignes cochées : un lettrage demande au moins deux lignes et un solde nul">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" MinWidth="100"/>
                                            <ColumnDefinition Width="*" MinWidth="100"/>
                                            <ColumnDefinition Width="*" MinWidth="100"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Solde lettrage" Style="{StaticResource EnteteTotal}" HorizontalAlignment="Left" Margin="0,0,20,2"/>
                                        <TextBlock Grid.Column="1" Text="Débit" Style="{StaticResource EnteteTotal}" Margin="0,0,0,2"/>
                                        <TextBlock Grid.Column="2" Text="Crédit" Style="{StaticResource EnteteTotal}" Margin="0,0,0,2"/>
                                        <TextBlock Grid.Column="3" Text="Solde" Style="{StaticResource EnteteTotal}" Margin="0,0,0,2"/>
                                        <TextBlock Grid.Row="1" Style="{StaticResource Discret}" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <Run Text="{Binding SelectionNombre, Mode=OneWay}"/>
                                            <Run Text="ligne(s) cochée(s)"/>
                                        </TextBlock>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectionDebit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource MontantTotal}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectionCredit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource MontantTotal}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectionSolde}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MontantTotal}">
                                                    <Setter Property="Foreground" Value="{StaticResource Avert}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectionEquilibree}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Succes}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ASelection}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource TexteDiscret}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="Lettre" Style="{StaticResource Etiquette}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="64" Text="{Binding ProchaineLettre, Mode=OneWay}" IsReadOnly="True" Margin="0,2,8,2"
                                             FontFamily="{StaticResource PoliceMono}" FontWeight="SemiBold"
                                             ToolTip="Première lettre libre sur ce compte : celle que prendra le prochain lettrage"/>
                                    <Button Content="Lettrer" Command="{Binding LettrerCommand}" Margin="0,2,16,2" MinWidth="90"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Le lettrage dans la base arrive avec sa procédure (lot 4). Pour l'instant : cochez les lignes pour en vérifier le solde, puis lettrez dans le logiciel comptable."/>
                                    <Button Style="{StaticResource BoutonFantome}" Command="{Binding ToutCocherCommand}" Margin="0,2,4,2"
                                            ToolTip="Cocher toutes les lignes affichées">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73A;" Style="{StaticResource Icone}" Margin="0,0,6,0"/>
                                            <TextBlock Text="Tout cocher"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BoutonFantome}" Command="{Binding ToutDecocherCommand}" Margin="0,2,0,2"
                                            ToolTip="Décocher toutes les lignes">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE739;" Style="{StaticResource Icone}" Margin="0,0,6,0"/>
                                            <TextBlock Text="Tout décocher"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </DockPanel>
                        </Border>

                        <Grid>
                            <DataGrid ItemsSource="{Binding Lignes}" AutoGenerateColumns="False" Margin="2,0,2,2"
                                      RowStyle="{StaticResource LigneInterrogation}"
                                      Visibility="{Binding AResultat, Converter={StaticResource BoolVisibilite}}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="P" Width="34" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Cochee, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                          Visibility="{Binding EstCochable, Converter={StaticResource BoolVisibilite}}"
                                                          ToolTip="Cocher la ligne pour le lettrage"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Code journal" Binding="{Binding Ligne.Journal}" Width="0.75*" MinWidth="52"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Ligne.Date, StringFormat={}{0:dd/MM/yyyy}}" Width="0.9*" MinWidth="80"/>
                                    <DataGridTextColumn Header="N° pièce" Binding="{Binding Ligne.Piece}" Width="0.75*" MinWidth="56"/>
                                    <DataGridTextColumn Header="N° facture" Binding="{Binding Ligne.RefPiece}" Width="0.95*" MinWidth="60" ElementStyle="{StaticResource CelluleTexte}"/>
                                    <DataGridTextColumn Header="Référence" Binding="{Binding Ligne.Reference}" Width="1*" MinWidth="60" ElementStyle="{StaticResource CelluleTexte}"/>
                                    <DataGridTextColumn Header="N° compte" Binding="{Binding Ligne.CompteAssocie}" Width="0.9*" MinWidth="60"
                                                        ElementStyle="{StaticResource CelluleTexte}"/>
                                    <DataGridTextColumn Header="Libellé écriture" Binding="{Binding Ligne.Libelle}" Width="2.4*" MinWidth="120" ElementStyle="{StaticResource CelluleTexte}"/>
                                    <DataGridTextColumn Header="Date échéance" Binding="{Binding Ligne.Echeance, StringFormat={}{0:dd/MM/yyyy}}" Width="0.9*" MinWidth="80"/>
                                    <DataGridTextColumn Header="Lettrage" Binding="{Binding Ligne.Lettrage}" Width="0.65*" MinWidth="50"/>
                                    <DataGridTextColumn Header="Pointage" Binding="{Binding Ligne.Pointage}" Width="0.65*" MinWidth="50"/>
                                    <DataGridTextColumn Header="Débit" Binding="{Binding Ligne.DebitAffiche, StringFormat={}{0:#,##0.##}}" Width="1*" MinWidth="80" ElementStyle="{StaticResource CelluleDroite}"/>
                                    <DataGridTextColumn Header="Crédit" Binding="{Binding Ligne.CreditAffiche, StringFormat={}{0:#,##0.##}}" Width="1*" MinWidth="80" ElementStyle="{StaticResource CelluleDroite}"/>
                                    <DataGridTextColumn Header="Solde progressif" Binding="{Binding Ligne.SoldeLibelle}" Width="1.15*" MinWidth="96" ElementStyle="{StaticResource CelluleDroite}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding SansResultat, Converter={StaticResource BoolVisibilite}}">
                                <TextBlock Text="&#xE721;" Style="{StaticResource Icone}" FontSize="28" Foreground="{StaticResource BordureForte}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Choisissez un compte puis « Afficher »" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                <TextBlock Text="Ses écritures s'affichent ici, avec le report à nouveau et le solde après chaque ligne."
                                           Style="{StaticResource Discret}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Aucune écriture ne correspond aux critères." Style="{StaticResource Discret}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding AucuneLigne, Converter={StaticResource BoolVisibilite}}"/>
                        </Grid>
                    </DockPanel>

                    <!-- ===== Cumuls généraux : mois par mois -->
                    <Grid Visibility="{Binding VueCumuls, Converter={StaticResource BoolVisibilite}}">
                        <DataGrid ItemsSource="{Binding Cumuls}" AutoGenerateColumns="False" Margin="2"
                                  Visibility="{Binding AResultat, Converter={StaticResource BoolVisibilite}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Période" Binding="{Binding Libelle}" Width="1.4*" MinWidth="120"/>
                                <DataGridTextColumn Header="Débit" Binding="{Binding DebitAffiche, StringFormat={}{0:#,##0.##}}" Width="1*" MinWidth="100" ElementStyle="{StaticResource CelluleDroite}"/>
                                <DataGridTextColumn Header="Crédit" Binding="{Binding CreditAffiche, StringFormat={}{0:#,##0.##}}" Width="1*" MinWidth="100" ElementStyle="{StaticResource CelluleDroite}"/>
                                <DataGridTextColumn Header="Solde du mois" Binding="{Binding SoldeLibelle}" Width="1*" MinWidth="110" ElementStyle="{StaticResource CelluleDroite}"/>
                                <DataGridTextColumn Header="Solde cumulé" Binding="{Binding SoldeCumuleLibelle}" Width="1*" MinWidth="110" ElementStyle="{StaticResource CelluleDroite}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Choisissez un compte puis « Afficher » : ses cumuls mensuels s'affichent ici." Style="{StaticResource Discret}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding SansResultat, Converter={StaticResource BoolVisibilite}}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Critères actifs | totaux et solde du compte -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Carte}" Padding="14,10" Margin="0,0,8,0" MinHeight="84">
                <TextBlock Text="{Binding Criteres}" TextWrapping="Wrap" Foreground="{StaticResource TexteSecondaire}"/>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanneauTotaux}" MinWidth="460">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="130"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="1" Text="Débit" Style="{StaticResource EnteteTotal}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Column="2" Text="Crédit" Style="{StaticResource EnteteTotal}" Margin="0,0,0,4"/>

                    <!-- Interrogation : totaux des lignes affichées ; cumuls : totaux des mois -->
                    <TextBlock Grid.Row="1" Text="Totaux" Style="{StaticResource LibelleTotal}"
                               ToolTip="Total des lignes affichées (report compris), selon le type d'écriture et la recherche"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalDebit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource MontantTotal}"
                               Visibility="{Binding VueInterrogation, Converter={StaticResource BoolVisibilite}}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TotalCredit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource MontantTotal}"
                               Visibility="{Binding VueInterrogation, Converter={StaticResource BoolVisibilite}}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CumulsDebit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource MontantTotal}"
                               Visibility="{Binding VueCumuls, Converter={StaticResource BoolVisibilite}}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CumulsCredit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource MontantTotal}"
                               Visibility="{Binding VueCumuls, Converter={StaticResource BoolVisibilite}}"/>

                    <TextBlock Grid.Row="2" Text="{Binding SoldeCompteTitre}" Style="{StaticResource LibelleTotal}" FontWeight="SemiBold"
                               ToolTip="Solde réel du compte, toutes écritures, quels que soient le type d'écriture et la recherche"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SoldeCompteDebit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource MontantTotal}"
                               FontWeight="SemiBold" Foreground="{StaticResource Primaire}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SoldeCompteCredit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource MontantTotal}"
                               FontWeight="SemiBold" Foreground="{StaticResource Primaire}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Barre d'état -->
        <Border Grid.Row="4" BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="2,6,2,0">
            <TextBlock Text="{Binding Resume}" Style="{StaticResource Discret}" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
