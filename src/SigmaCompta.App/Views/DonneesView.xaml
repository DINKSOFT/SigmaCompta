<UserControl x:Class="SigmaCompta.App.Views.DonneesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SigmaCompta.App.Controls"
             AllowDrop="True" Drop="SurDepot" DragOver="SurSurvolDepot">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- =================================================== Fichier de paramètres -->
        <Border Style="{StaticResource Carte}" Padding="22,20,22,12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource AccentDoux}">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icone}" FontSize="{StaticResource TailleKpi}" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Fichier de paramètres" Style="{StaticResource TitreCarte}"/>
                            <Border Style="{StaticResource Pastille}" Background="{StaticResource AvertDoux}" Margin="10,0,0,0"
                                    Visibility="{Binding ProfilEstModifie, Converter={StaticResource BoolVisibilite}}">
                                <TextBlock Text="non enregistré" Style="{StaticResource TextePastille}" Foreground="{StaticResource Avert}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Correspondance des colonnes, format et règles de regroupement" Style="{StaticResource Discret}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Profils}" SelectedItem="{Binding ProfilSelectionne}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Icone}" FontSize="{StaticResource TailleTexte}" Foreground="{StaticResource TexteDiscret}" Margin="0,0,9,0"/>
                                    <TextBlock Text="{Binding Nom}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Fichier, StringFormat='  ·  {0}'}" Foreground="{StaticResource TexteDiscret}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                        <Button Style="{StaticResource BoutonIcone}" Content="&#xE710;" ToolTip="Nouveau profil" Command="{Binding NouveauProfilCommand}"/>
                        <Button Style="{StaticResource BoutonIcone}" Content="&#xE8E5;" ToolTip="Ouvrir un fichier de paramètres (.json)…" Command="{Binding OuvrirProfilCommand}"/>
                        <Button Style="{StaticResource BoutonIcone}" Content="&#xE74E;" ToolTip="Enregistrer" Command="{Binding EnregistrerProfilCommand}"/>
                        <Button Style="{StaticResource BoutonIcone}" Content="&#xE792;" ToolTip="Enregistrer sous…" Command="{Binding EnregistrerProfilSousCommand}"/>
                        <Button Style="{StaticResource BoutonIcone}" Content="&#xE8B7;" ToolTip="Ouvrir le dossier des profils" Command="{Binding OuvrirDossierProfilsCommand}"/>
                    </StackPanel>
                </Grid>
                <TextBlock DockPanel.Dock="Top" Text="{Binding CheminProfil}" Style="{StaticResource Discret}" FontSize="{StaticResource TaillePetite}" Margin="2,6,0,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding CheminProfil}"/>

                <TabControl Style="{StaticResource Onglets}" Margin="0,10,0,0">
                    <!-- Colonnes -->
                    <TabItem Header="Colonnes">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Discret}" Margin="0,0,0,10" LineHeight="18"
                                       Text="Noms d'en-tête possibles séparés par « | » (casse et accents ignorés). [C] désigne directement la colonne C."/>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="128"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CHAMP" Style="{StaticResource KpiLibelle}"/>
                                <TextBlock Grid.Column="1" Text="NOMS RECHERCHÉS" Style="{StaticResource KpiLibelle}"/>
                                <TextBlock Grid.Column="2" Text="TROUVÉ" Style="{StaticResource KpiLibelle}" Margin="10,0,0,0"/>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Champs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="128"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="128"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0">
                                                    <Run Text="{Binding Libelle, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Foreground="{StaticResource Erreur}">
                                                        <Run.Style>
                                                            <Style TargetType="Run">
                                                                <Setter Property="Text" Value=""/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Obligatoire}" Value="True">
                                                                        <Setter Property="Text" Value="*"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Run.Style>
                                                    </Run>
                                                </TextBlock>
                                                <TextBox Grid.Column="1" Text="{Binding Candidats}" FontSize="{StaticResource TailleTexte}" MinHeight="32" Padding="8,5"
                                                         ToolTip="{Binding Candidats}"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="{StaticResource TailleTexte}" Margin="0,0,6,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icone}">
                                                                <Setter Property="Text" Value="&#xE738;"/>
                                                                <Setter Property="Foreground" Value="{StaticResource TexteDiscret}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EstTrouvee}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE73E;"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource Succes}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Manquante}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE711;"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource Erreur}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock FontSize="{StaticResource TailleTexte}" TextTrimming="CharacterEllipsis" MaxWidth="104" ToolTip="{Binding ColonneTrouvee}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding ColonneTrouvee}"/>
                                                                <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Manquante}" Value="True">
                                                                        <Setter Property="Text" Value="introuvable"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource Erreur}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- Format du fichier -->
                    <TabItem Header="Format">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Type de fichier" Style="{StaticResource Etiquette}"/>
                                    <ComboBox ItemsSource="{Binding TypesSource}" DisplayMemberPath="Libelle" SelectedValuePath="Valeur" SelectedValue="{Binding TypeSource}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,16">
                                    <TextBlock Text="Ligne d'en-tête" Style="{StaticResource Etiquette}"/>
                                    <TextBox Text="{Binding LigneEntete}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                                    <TextBlock Text="Séparateur (CSV)" Style="{StaticResource Etiquette}"/>
                                    <ComboBox ItemsSource="{Binding Separateurs}" DisplayMemberPath="Libelle" SelectedValuePath="Valeur" SelectedValue="{Binding Separateur}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                                    <TextBlock Text="Encodage (CSV)" Style="{StaticResource Etiquette}"/>
                                    <ComboBox ItemsSource="{Binding Encodages}" DisplayMemberPath="Libelle" SelectedValuePath="Valeur" SelectedValue="{Binding Encodage}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                                    <TextBlock Text="Séparateur décimal" Style="{StaticResource Etiquette}"/>
                                    <ComboBox ItemsSource="{Binding SeparateursDecimaux}" DisplayMemberPath="Libelle" SelectedValuePath="Valeur" SelectedValue="{Binding SeparateurDecimal}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.ColumnSpan="3">
                                    <TextBlock Text="Formats de date acceptés" Style="{StaticResource Etiquette}"/>
                                    <TextBox Text="{Binding FormatsDate}" FontFamily="{StaticResource PoliceMono}" FontSize="{StaticResource TailleTexte}"/>
                                    <TextBlock Style="{StaticResource Discret}" Margin="2,6,0,0"
                                               Text="Séparés par « | ». Les dates Excel natives et le format AAAA-MM-JJ sont toujours reconnus."/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Pièces & options -->
                    <TabItem Header="Pièces &amp; options">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,8">
                                <TextBlock Text="Regroupement des lignes en pièces" Style="{StaticResource Etiquette}"/>
                                <ComboBox ItemsSource="{Binding ModesRegroupementDisponibles}" DisplayMemberPath="Libelle" SelectedValuePath="Valeur" SelectedValue="{Binding Regroupement}"/>
                                <TextBlock Style="{StaticResource Discret}" Margin="2,6,0,16" LineHeight="18"
                                           Text="Une pièce = un appel à la procédure : une date, un journal, débits = crédits."/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Journal par défaut" Style="{StaticResource Etiquette}"/>
                                        <ComboBox IsEditable="True" ItemsSource="{Binding Journaux}" DisplayMemberPath="Affichage"
                                                  TextSearch.TextPath="Code" Text="{Binding JournalDefaut, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Longueur des comptes" Style="{StaticResource Etiquette}"/>
                                        <TextBox Text="{Binding LongueurComptes}" ToolTip="0 = comptes pris tels quels ; 7 = 422 devient 4220000"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Libellé par défaut" Style="{StaticResource Etiquette}" Margin="0,16,0,6"/>
                                <TextBox Text="{Binding LibelleDefaut}" Tag="Utilisé quand une ligne n'a pas de libellé"/>

                                <Border Style="{StaticResource Separateur}" Margin="0,20,0,16"/>
                                <CheckBox Style="{StaticResource Interrupteur}" IsChecked="{Binding NumerotationAutomatique}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Numérotation automatique des pièces" FontWeight="SemiBold"/>
                                        <TextBlock Text="Ignore les n° du fichier : la procédure attribue le suivant selon le journal." Style="{StaticResource Discret}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource Interrupteur}" IsChecked="{Binding InverserMontantsNegatifs}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Inverser les montants négatifs" FontWeight="SemiBold"/>
                                        <TextBlock Text="Un débit de -500 devient un crédit de 500." Style="{StaticResource Discret}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource Interrupteur}" IsChecked="{Binding IgnorerLignesSansMontant}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Ignorer les lignes sans montant" FontWeight="SemiBold"/>
                                        <TextBlock Text="Lignes de titre, de total vide ou de séparation du tableur." Style="{StaticResource Discret}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <Border Style="{StaticResource Separateur}" Margin="0,8,0,16"/>
                                <TextBlock Text="Nom du profil" Style="{StaticResource Etiquette}"/>
                                <TextBox Text="{Binding NomProfil}"/>
                                <TextBlock Text="Description" Style="{StaticResource Etiquette}" Margin="0,14,0,6"/>
                                <TextBox Text="{Binding DescriptionProfil}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <!-- =================================================== Fichier de données -->
        <DockPanel Grid.Column="2">
            <!-- Zone de dépôt (aucun fichier) -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,18" Visibility="{Binding AFichier, Converter={StaticResource BoolVisibilite}, ConverterParameter=inverse}">
                <Grid MinHeight="210">
                    <Rectangle RadiusX="16" RadiusY="16" Stroke="{StaticResource PrimaireBordure}" StrokeThickness="2" StrokeDashArray="5 4"
                               Fill="#F8FAFF"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <Border Width="62" Height="62" CornerRadius="31" Background="{StaticResource PrimaireDoux}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE898;" Style="{StaticResource Icone}" FontSize="{StaticResource TailleTitrePage}" Foreground="{StaticResource Primaire}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Glisse ton fichier Excel ou CSV ici" Style="{StaticResource TitreCarte}" FontSize="{StaticResource TailleTitreCarte}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                        <TextBlock Text=".xlsx, .xlsm, .csv ou .txt — brouillard, export de paie, relevé…" Style="{StaticResource Discret}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Style="{StaticResource BoutonPrimaire}" Command="{Binding ParcourirCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" Style="{StaticResource Icone}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Parcourir…"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="10,0,0,0" Style="{StaticResource BoutonFantome}" Command="{Binding ModeleExcelCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icone}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Modèle Excel"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BoutonFantome}" Command="{Binding ModeleCsvCommand}" Content="Modèle CSV"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Fichier chargé -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Carte}" Margin="0,0,0,14" Padding="18,14"
                    Visibility="{Binding AFichier, Converter={StaticResource BoolVisibilite}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="11">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource InfoDoux}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EstExcel}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccesDoux}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="{StaticResource TaillePetite}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="CSV"/>
                                    <Setter Property="Foreground" Value="{StaticResource Info}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EstExcel}" Value="True">
                                            <Setter Property="Text" Value="XLSX"/>
                                            <Setter Property="Foreground" Value="{StaticResource Succes}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NomFichier}" FontWeight="SemiBold" FontSize="{StaticResource TailleAccent}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CheminFichier}"/>
                        <TextBlock Text="{Binding InfoFichier}" Style="{StaticResource Discret}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Feuilles}" SelectedItem="{Binding FeuilleSelectionnee}" MinWidth="150" Margin="0,0,10,0"
                                  ToolTip="Feuille du classeur" Visibility="{Binding EstExcel, Converter={StaticResource BoolVisibilite}}"/>
                        <Button Style="{StaticResource BoutonIcone}" Content="&#xE72C;" ToolTip="Relire le fichier (après modification dans Excel)" Command="{Binding RechargerCommand}"/>
                        <Button Margin="6,0,0,0" Command="{Binding ParcourirCommand}" Content="Changer…"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bandeau de correspondance -->
            <Border DockPanel.Dock="Top" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SuccesDoux}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ColonnesManquantes}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AvertDoux}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding AFichier}" Value="False">
                                <Setter Property="Background" Value="{StaticResource SurfaceSurvol}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8FD;" Style="{StaticResource Icone}" Margin="0,0,10,0" Foreground="{StaticResource TexteSecondaire}"/>
                    <TextBlock Text="{Binding ResumeCorrespondance}" TextWrapping="Wrap" Foreground="{StaticResource Texte}"/>
                </StackPanel>
            </Border>

            <!-- Action -->
            <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Discret}" FontSize="{StaticResource TailleTexte}" MaxWidth="520" HorizontalAlignment="Left"
                           Text="L'analyse regroupe les lignes en pièces puis vérifie journaux, comptes, tiers, périodes et équilibre — sans rien écrire."/>
                <Button HorizontalAlignment="Right" Style="{StaticResource BoutonPrimaire}" Command="{Binding AnalyserCommand}" Padding="22,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icone}" Margin="0,0,9,0"/>
                        <TextBlock Text="Analyser et contrôler"/>
                        <TextBlock Text="&#xE72A;" Style="{StaticResource Icone}" FontSize="{StaticResource TailleTexte}" Margin="10,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Aperçu -->
            <Border Style="{StaticResource Carte}" Padding="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="20,14,20,12">
                        <TextBlock Text="Aperçu du fichier" Style="{StaticResource TitreCarte}"/>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Discret}"
                                   Text="{Binding NombreLignes, StringFormat={}{0:N0} ligne(s) de données · 500 premières affichées}"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Bordure}"/>
                    <Grid>
                        <DataGrid ItemsSource="{Binding Apercu}" AutoGenerateColumns="True" c:Aides.EntetesLisibles="True"
                                  FrozenColumnCount="1" FontSize="{StaticResource TailleTexte}" Margin="2,0,2,4"/>
                        <TextBlock Text="Aucun fichier chargé" Style="{StaticResource Discret}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding AFichier, Converter={StaticResource BoolVisibilite}, ConverterParameter=inverse}"/>
                    </Grid>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
