<UserControl x:Class="SigmaCompta.App.Views.ControleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Cartes KPI plus basses : l'écran doit tenir sur un portable 1920×1080 à 150 % -->
        <Style x:Key="CarteKpiCompacte" TargetType="Border" BasedOn="{StaticResource CarteKpi}">
            <Setter Property="Padding" Value="16,10"/>
        </Style>
        <!-- Pastille de statut d'une pièce (DataContext = PieceVM) -->
        <DataTemplate x:Key="PastilleStatut">
            <Border Style="{StaticResource Pastille}" Background="{Binding Statut, Converter={StaticResource Statut}, ConverterParameter=fond}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icone}" FontSize="{StaticResource TailleMini}" Margin="0,0,5,0"
                               Text="{Binding Statut, Converter={StaticResource Statut}, ConverterParameter=icone}"
                               Foreground="{Binding Statut, Converter={StaticResource Statut}, ConverterParameter=texte}"/>
                    <TextBlock Text="{Binding StatutLibelle}" Style="{StaticResource TextePastille}"
                               Foreground="{Binding Statut, Converter={StaticResource Statut}, ConverterParameter=texte}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- ============ Indicateurs -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CarteKpiCompacte}">
                <StackPanel>
                    <TextBlock Text="PIÈCES" Style="{StaticResource KpiLibelle}"/>
                    <TextBlock Text="{Binding NombrePieces, StringFormat={}{0:N0}}" Style="{StaticResource Kpi}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CarteKpiCompacte}">
                <StackPanel>
                    <TextBlock Text="LIGNES" Style="{StaticResource KpiLibelle}"/>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="{Binding NombreLignes, StringFormat={}{0:N0}}" Style="{StaticResource Kpi}"/>
                        <TextBlock Margin="8,0,0,5" VerticalAlignment="Bottom" FontSize="{StaticResource TaillePetite}" Foreground="{StaticResource TexteDiscret}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding LignesIgnorees, Converter={StaticResource ValeurVisibilite}}"
                                   Text="{Binding LignesIgnorees, StringFormat={}+ {0} ignorée(s)}">
                            <TextBlock.ToolTip>
                                <TextBlock Text="{Binding LignesIgnorees, StringFormat={}{0} ligne(s) ignorée(s) car sans montant}"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CarteKpiCompacte}">
                <StackPanel>
                    <TextBlock Text="TOTAL DÉBIT" Style="{StaticResource KpiLibelle}"/>
                    <TextBlock Text="{Binding TotalDebit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource Kpi}" FontSize="{StaticResource TailleKpi}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CarteKpiCompacte}">
                <StackPanel>
                    <TextBlock Text="TOTAL CRÉDIT" Style="{StaticResource KpiLibelle}"/>
                    <TextBlock Text="{Binding TotalCredit, StringFormat={}{0:#,##0.##}}" Style="{StaticResource Kpi}" FontSize="{StaticResource TailleKpi}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CarteKpiCompacte}">
                <StackPanel>
                    <TextBlock Text="EN ERREUR" Style="{StaticResource KpiLibelle}"/>
                    <TextBlock Text="{Binding NombreErreurs}" Style="{StaticResource Kpi}" Margin="0,4,0,0" Foreground="{StaticResource Erreur}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="5" Style="{StaticResource CarteKpiCompacte}" Margin="0">
                <StackPanel>
                    <TextBlock Text="SIMULÉES OK" Style="{StaticResource KpiLibelle}"/>
                    <TextBlock Style="{StaticResource Kpi}" Margin="0,4,0,0" Foreground="{StaticResource Succes}">
                        <Run Text="{Binding NombreSimulees, Mode=OneWay}"/><Run Text=" / " Foreground="{StaticResource TexteDiscret}"/><Run Text="{Binding NombreValides, Mode=OneWay}" Foreground="{StaticResource TexteDiscret}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ Synthèse + actions -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Carte}" Padding="16,10" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Synthese}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="{StaticResource TailleTexte}" Margin="0,0,16,0"
                               Visibility="{Binding EnCours, Converter={StaticResource BoolVisibilite}, ConverterParameter=inverse}"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding EnCours, Converter={StaticResource BoolVisibilite}}">
                        <ProgressBar Value="{Binding Progression, Mode=OneWay}" Maximum="100"/>
                        <TextBlock Text="{Binding MessageProgression}" Style="{StaticResource Discret}" Margin="0,6,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource BoutonIcone}" Content="&#xE72C;" ToolTip="Recharger le référentiel comptable et revalider" Command="{Binding RevaliderCommand}"/>
                        <Button Margin="6,0,0,0" Style="{StaticResource BoutonFantome}" Command="{Binding ExporterAnomaliesCommand}" ToolTip="Lignes en anomalie, pour correction dans le fichier source">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icone}" Margin="0,0,8,0"/>
                                <TextBlock Text="Anomalies"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BoutonFantome}" Command="{Binding ExporterRapportCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icone}" Margin="0,0,8,0"/>
                                <TextBlock Text="Rapport"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Style="{StaticResource BoutonDanger}" Command="{Binding AnnulerCommand}" Content="Interrompre"
                                Visibility="{Binding EnCours, Converter={StaticResource BoolVisibilite}}"/>
                        <Button Margin="8,0,0,0" Style="{StaticResource BoutonPrimaire}" Command="{Binding SimulerCommand}"
                                ToolTip="Appelle imp.PS_ImportPiece avec @Simulation = 1 : les déclencheurs de la base valident chaque pièce puis tout est annulé.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icone}" Margin="0,0,8,0"/>
                                <TextBlock Text="Simuler sur le serveur"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Margin="0,10,0,0" Background="{StaticResource InfoDoux}" CornerRadius="10" Padding="12,7"
                        Visibility="{Binding DiagnosticHash, Converter={StaticResource ValeurVisibilite}}">
                    <DockPanel>
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icone}" Foreground="{StaticResource Info}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding DiagnosticHash}" TextWrapping="Wrap" Foreground="{StaticResource Texte}"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ============ Pied -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button HorizontalAlignment="Left" Style="{StaticResource BoutonFantome}" Command="{Binding RetourDonneesCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72A;" Style="{StaticResource Icone}" FontSize="{StaticResource TailleTexte}" Margin="0,0,9,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform ScaleX="-1"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="Retour aux données"/>
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Right" Style="{StaticResource BoutonPrimaire}" Command="{Binding ContinuerCommand}" Padding="20,9">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Passer à l'import"/>
                    <TextBlock Text="&#xE72A;" Style="{StaticResource Icone}" FontSize="{StaticResource TailleTexte}" Margin="10,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ============ Pièces + détail -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="5*" MinHeight="100"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="4*" MinHeight="85"/>
            </Grid.RowDefinitions>

            <!-- Filtres -->
            <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource PuceFiltre}" GroupName="filtre" Content="Toutes"
                                 IsChecked="{Binding Filtre, Converter={StaticResource EgalVersBool}, ConverterParameter=Toutes}"/>
                    <RadioButton Style="{StaticResource PuceFiltre}" GroupName="filtre"
                                 IsChecked="{Binding Filtre, Converter={StaticResource EgalVersBool}, ConverterParameter=Erreurs}">
                        <TextBlock><Run Text="Erreurs · "/><Run Text="{Binding NombreErreurs, Mode=OneWay}"/></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource PuceFiltre}" GroupName="filtre"
                                 IsChecked="{Binding Filtre, Converter={StaticResource EgalVersBool}, ConverterParameter=Avertissements}">
                        <TextBlock><Run Text="Avertissements · "/><Run Text="{Binding NombreAvertissements, Mode=OneWay}"/></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource PuceFiltre}" GroupName="filtre" Content="Valides"
                                 IsChecked="{Binding Filtre, Converter={StaticResource EgalVersBool}, ConverterParameter=Valides}"/>
                </StackPanel>
                <TextBox HorizontalAlignment="Right" Width="300" Tag="Rechercher : journal, pièce, compte, libellé…"
                         Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged, Delay=250}"/>
            </Grid>

            <!-- Liste des pièces -->
            <Border Grid.Row="1" Style="{StaticResource Carte}" Padding="0">
                <DataGrid ItemsSource="{Binding Pieces}" SelectedItem="{Binding PieceSelectionnee}" AutoGenerateColumns="False" Margin="2">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="STATUT" Width="128" MinWidth="128" CellTemplate="{StaticResource PastilleStatut}" SortMemberPath="Statut"/>
                        <DataGridTextColumn Header="N°" Binding="{Binding Numero}" Width="44" MinWidth="44"/>
                        <DataGridTextColumn Header="JOURNAL" Binding="{Binding Journal}" Width="76" MinWidth="76" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" Width="88" MinWidth="88"/>
                        <DataGridTextColumn Header="PIÈCE" Binding="{Binding PieceAffichee}" Width="80" MinWidth="80" ElementStyle="{StaticResource CelluleTexte}"/>
                        <DataGridTextColumn Header="LIBELLÉ" Binding="{Binding Libelle}" Width="*" MinWidth="110" ElementStyle="{StaticResource CelluleTexte}"/>
                        <DataGridTextColumn Header="LIGNES" Binding="{Binding NombreLignes}" Width="62" MinWidth="62" ElementStyle="{StaticResource CelluleDroite}"/>
                        <DataGridTextColumn Header="DÉBIT" Binding="{Binding TotalDebit, StringFormat={}{0:#,##0.##}}" Width="96" MinWidth="96" ElementStyle="{StaticResource CelluleDroite}"/>
                        <DataGridTextColumn Header="CRÉDIT" Binding="{Binding TotalCredit, StringFormat={}{0:#,##0.##}}" Width="96" MinWidth="96" ElementStyle="{StaticResource CelluleDroite}"/>
                        <DataGridTextColumn Header="MESSAGE" Binding="{Binding Resume}" Width="1.4*" MinWidth="140" ElementStyle="{StaticResource CelluleTexte}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Row="2" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>

            <!-- Détail de la pièce sélectionnée -->
            <Border Grid.Row="3" Style="{StaticResource Carte}" Padding="0">
                <Grid>
                    <TextBlock Text="Sélectionne une pièce pour voir ses lignes." Style="{StaticResource Discret}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding APieceSelectionnee, Converter={StaticResource BoolVisibilite}, ConverterParameter=inverse}"/>
                    <DockPanel Visibility="{Binding APieceSelectionnee, Converter={StaticResource BoolVisibilite}}">
                        <Grid DockPanel.Dock="Top" Margin="18,10,18,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource TitreCarte}" FontSize="{StaticResource TailleAccent}">
                                    <Run Text="Pièce n°"/><Run Text="{Binding PieceSelectionnee.Numero, Mode=OneWay}"/>
                                    <Run Text="·" Foreground="{StaticResource TexteDiscret}"/>
                                    <Run Text="{Binding PieceSelectionnee.Journal, Mode=OneWay}"/>
                                    <Run Text="{Binding PieceSelectionnee.Date, StringFormat={}{0:dd/MM/yyyy}, Mode=OneWay}"/>
                                    <Run Text="·" Foreground="{StaticResource TexteDiscret}"/>
                                    <Run Text="{Binding PieceSelectionnee.PieceAffichee, Mode=OneWay}"/>
                                </TextBlock>
                                <ContentControl Margin="12,0,0,0" Content="{Binding PieceSelectionnee}" ContentTemplate="{StaticResource PastilleStatut}" Focusable="False"/>
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Discret}"
                                           Visibility="{Binding PieceSelectionnee.PlageEcNo, Converter={StaticResource ValeurVisibilite}}">
                                    <Run Text="EC_No"/><Run Text="{Binding PieceSelectionnee.PlageEcNo, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <ItemsControl Grid.Column="1" Margin="18,0,0,0" ItemsSource="{Binding PieceSelectionnee.Anomalies}" MaxHeight="56">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Style="{StaticResource Icone}" FontSize="{StaticResource TaillePetite}" Margin="0,0,7,0" VerticalAlignment="Top"
                                                       Text="{Binding Niveau, Converter={StaticResource Statut}, ConverterParameter=icone}"
                                                       Foreground="{Binding Niveau, Converter={StaticResource Statut}, ConverterParameter=texte}"/>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="{StaticResource TailleTexte}"
                                                       Foreground="{Binding Niveau, Converter={StaticResource Statut}, ConverterParameter=texte}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Bordure}"/>
                        <DataGrid ItemsSource="{Binding PieceSelectionnee.Lignes}" AutoGenerateColumns="False" Margin="2" FontSize="{StaticResource TailleTexte}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="LIGNE" Binding="{Binding LigneFichier}" Width="64" MinWidth="64"/>
                                <DataGridTextColumn Header="COMPTE" Binding="{Binding CompteGeneral}" Width="96" MinWidth="96" FontWeight="SemiBold" ElementStyle="{StaticResource CelluleTexte}"/>
                                <DataGridTextColumn Header="INTITULÉ" Binding="{Binding IntituleCompte}" Width="*" MinWidth="120" ElementStyle="{StaticResource CelluleTexte}"/>
                                <DataGridTextColumn Header="TIERS" Binding="{Binding CompteTiers}" Width="88" MinWidth="88" ElementStyle="{StaticResource CelluleTexte}"/>
                                <DataGridTextColumn Header="LIBELLÉ" Binding="{Binding Libelle}" Width="1.2*" MinWidth="130" ElementStyle="{StaticResource CelluleTexte}"/>
                                <DataGridTextColumn Header="DÉBIT" Binding="{Binding Debit, StringFormat={}{0:#,##0.##;;#}}" Width="96" MinWidth="96" ElementStyle="{StaticResource CelluleDroite}"/>
                                <DataGridTextColumn Header="CRÉDIT" Binding="{Binding Credit, StringFormat={}{0:#,##0.##;;#}}" Width="96" MinWidth="96" ElementStyle="{StaticResource CelluleDroite}"/>
                                <DataGridTextColumn Header="EC_NO" Binding="{Binding EcNo}" Width="66" MinWidth="66"/>
                                <DataGridTemplateColumn Header="ANOMALIES" Width="1.4*" MinWidth="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ResumeAnomalies}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResumeAnomalies}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Avert}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AErreur}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Erreur}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
