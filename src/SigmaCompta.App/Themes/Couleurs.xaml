<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Palette Sigma Compta : marine profond + indigo + turquoise -->
    <Color x:Key="CPrimaire">#3557E0</Color>
    <Color x:Key="CPrimaireFonce">#2742B8</Color>
    <Color x:Key="CAccent">#0FB5A6</Color>
    <Color x:Key="CMarine1">#0B1628</Color>
    <Color x:Key="CMarine2">#14264A</Color>
    <Color x:Key="COmbre">#1E2A44</Color>

    <SolidColorBrush x:Key="Fond" Color="#F3F5FA"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="SurfaceSurvol" Color="#F0F3FA"/>
    <SolidColorBrush x:Key="Bordure" Color="#E3E8F1"/>
    <SolidColorBrush x:Key="BordureForte" Color="#C9D2E2"/>

    <SolidColorBrush x:Key="Texte" Color="#152033"/>
    <SolidColorBrush x:Key="TexteSecondaire" Color="#56627A"/>
    <SolidColorBrush x:Key="TexteDiscret" Color="#8A95A8"/>
    <SolidColorBrush x:Key="TexteInverse" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Primaire" Color="{StaticResource CPrimaire}"/>
    <SolidColorBrush x:Key="PrimaireFonce" Color="{StaticResource CPrimaireFonce}"/>
    <SolidColorBrush x:Key="PrimaireDoux" Color="#EBF0FF"/>
    <SolidColorBrush x:Key="PrimaireBordure" Color="#C3D0FA"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource CAccent}"/>
    <SolidColorBrush x:Key="AccentDoux" Color="#E2F7F4"/>

    <SolidColorBrush x:Key="Succes" Color="#15964A"/>
    <SolidColorBrush x:Key="SuccesDoux" Color="#E6F6EC"/>
    <SolidColorBrush x:Key="Avert" Color="#C46A06"/>
    <SolidColorBrush x:Key="AvertDoux" Color="#FFF3DF"/>
    <SolidColorBrush x:Key="Erreur" Color="#D42A2A"/>
    <SolidColorBrush x:Key="ErreurDoux" Color="#FDEBEB"/>
    <SolidColorBrush x:Key="Info" Color="#2563EB"/>
    <SolidColorBrush x:Key="InfoDoux" Color="#EAF1FF"/>

    <!-- Barre latérale -->
    <LinearGradientBrush x:Key="FondLateral" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="{StaticResource CMarine1}" Offset="0"/>
        <GradientStop Color="{StaticResource CMarine2}" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LateralTexte" Color="#A9B6CE"/>
    <SolidColorBrush x:Key="LateralTexteDiscret" Color="#6E7D99"/>
    <SolidColorBrush x:Key="LateralSurvol" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="LateralActif" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="LateralBordure" Color="#1FFFFFFF"/>

    <LinearGradientBrush x:Key="DegradeMarque" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource CPrimaire}" Offset="0"/>
        <GradientStop Color="{StaticResource CAccent}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DegradeProgression" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource CPrimaire}" Offset="0"/>
        <GradientStop Color="{StaticResource CAccent}" Offset="1"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="OmbreCarte" BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.07" Color="{StaticResource COmbre}"/>
    <DropShadowEffect x:Key="OmbreFlottante" BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.18" Color="{StaticResource COmbre}"/>

    <FontFamily x:Key="PoliceTexte">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="PoliceTitre">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="PoliceIcones">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="PoliceMono">Cascadia Mono, Consolas</FontFamily>

    <!-- Typographie : tailles de texte de toute l'application (en pixels WPF).
         TailleTexte est le texte courant de tous les écrans ; les autres tailles en découlent.
         Pour agrandir ou réduire l'ensemble, changer ces valeurs en gardant leurs écarts. -->
    <sys:Double x:Key="TailleMini">9.5</sys:Double>       <!-- mentions, petites icônes -->
    <sys:Double x:Key="TaillePetite">10</sys:Double>      <!-- libellés secondaires, en-têtes de colonnes -->
    <sys:Double x:Key="TailleTexte">11</sys:Double>       <!-- texte courant : grilles, champs, boutons, listes -->
    <sys:Double x:Key="TailleAccent">12</sys:Double>      <!-- icônes, textes mis en avant -->
    <sys:Double x:Key="TailleTitreCarte">13</sys:Double>  <!-- titres de cartes -->
    <sys:Double x:Key="TailleKpi">15</sys:Double>         <!-- chiffres des indicateurs -->
    <sys:Double x:Key="TailleGrand">18</sys:Double>
    <sys:Double x:Key="TailleTitrePage">20</sys:Double>   <!-- titre de l'écran -->
</ResourceDictionary>
