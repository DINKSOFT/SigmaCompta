<Application x:Class="SigmaCompta.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SigmaCompta.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Couleurs.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolVisibilite x:Key="BoolVisibilite"/>
            <conv:ValeurVisibilite x:Key="ValeurVisibilite"/>
            <conv:InverseBool x:Key="InverseBool"/>
            <conv:EgalVersBool x:Key="EgalVersBool"/>
            <conv:Initiale x:Key="Initiale"/>
            <conv:StatutApparence x:Key="Statut"/>
            <conv:LibelleStatut x:Key="LibelleStatut"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
